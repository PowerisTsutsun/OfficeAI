# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Company AI Desktop"
APP_ENV=development
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://app_user:changeme@localhost:5432/company_ai

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT (generate with: openssl genrsa -out private.pem 4096)  ─────────────────
# Paste PEM key content with \n between lines, or use a file path
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate with: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64

# ── AI Providers ──────────────────────────────────────────────────────────────
# In production, these come from Vault / AWS Secrets Manager / Azure Key Vault
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# ── Auth ──────────────────────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAINS=company.com,company.co.uk
MAGIC_LINK_BASE_URL=http://localhost:1420

# ── Email (magic links) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USER=noreply@company.com
SMTP_PASSWORD=
EMAIL_FROM=noreply@company.com

# ── OIDC SSO (optional) ────────────────────────────────────────────────────────
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=tauri://localhost,http://localhost:1420
